{
  "name": "tissue-tag",
  "productName": "TissueTag",
  "version": "1.0.0",
  "description": "TissueTag — Tissue labels for samples",
  "main": "main.js",
  "author": {
    "name": "Marcelo José Sturaro",
    "email": "marcelosturaro@users.noreply.github.com"
  },
  "homepage": "https://github.com/marcelosturaro/tissue_tag",
  "license": "MIT",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.js",
    "start": "npm run prepare-assets && electron .",
    "dist": "npm run prepare-assets && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "qrcode-generator": "1.4.4"
  },
  "build": {
    "appId": "br.unifesp.cururulab.tissuetag",
    "productName": "TissueTag",
    "copyright": "© 2026 Marcelo José Sturaro, Cururu Lab, UNIFESP",
    "files": ["main.js", "index.html", "logo.png", "vendor/**/*"],
    "directories": { "buildResources": "build", "output": "dist" },
    "artifactName": "TissueTag-${version}-${os}-${arch}.${ext}",
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Education",
      "maintainer": "Marcelo José Sturaro <marcelosturaro@users.noreply.github.com>"
    }
  }
}
